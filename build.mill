//| mill-version: 1.1.8
package build

import mill._
import mill.scalalib._

object `chisel-riscv-soc-lab` extends SbtModule {
  def scalaVersion = "2.13.18"
  def chiselVersion = "7.15.0"

  // Root-level build.mill: a top-level module defaults its source dir to
  // <repo>/<module-name>/. os.up moves it back to the repo root so sbt and
  // Mill read the same src/main/scala and src/test/scala.
  def moduleDir = super.moduleDir / os.up

  override def scalacOptions = Seq(
    "-language:reflectiveCalls",
    "-deprecation",
    "-feature",
    "-Xcheckinit",
    "-Ymacro-annotations",
  )
  override def mvnDeps = Seq(
    mvn"org.chipsalliance::chisel:$chiselVersion",
  )
  override def scalacPluginMvnDeps = Seq(
    mvn"org.chipsalliance:::chisel-plugin:$chiselVersion",
  )
  object test extends SbtTests with TestModule.ScalaTest {
    override def mvnDeps = Seq(
      mvn"org.scalatest::scalatest::3.2.19"
    )
  }
}
